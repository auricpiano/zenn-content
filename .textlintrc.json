{
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": {
        "max": 120
      },
      "max-comma": {
        "max": 4
      },
      "max-kanji-continuous-len": false,
      "no-exclamation-question-mark": false,
      "ja-no-mixed-period": {
        "allowPeriodMarks": ["：", ":"]
      },
      "no-doubled-joshi": {
        "min_interval": 1,
        "allow": ["も", "や"]
      }
    }
  }
}
